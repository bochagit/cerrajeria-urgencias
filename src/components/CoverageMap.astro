---
import { SITE } from "../data/site";
import { ZONAS } from "../data/content";

const { latitude, longitude, zoom } = SITE.map;
// `ll` centra el mapa sin agregar un marcador sobre la 9 de Julio.
const embedUrl = `https://www.google.com/maps?ll=${latitude},${longitude}&z=${zoom}&t=m&hl=es&gl=ar&mapclient=embed&output=embed`;
const externalUrl = `https://www.google.com/maps/@${latitude},${longitude},${zoom}z?hl=es`;
---

<div>
  <div
    class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl border border-carbon-grafito/15 bg-blanco-hueso"
  >
    <iframe
      title="Mapa del área operativa: CABA y primer cordón del Gran Buenos Aires"
      src={embedUrl}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="absolute inset-0 z-0 h-full w-full border-0"
    ></iframe>
  </div>

  <a
    href={externalUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-carbon-grafito/70 underline underline-offset-4 transition-colors hover:text-carbon-grafito"
  >
    Abrir en Google Maps
    <span aria-hidden="true">↗</span>
  </a>

  <ul class="mt-4 grid gap-2 sm:grid-cols-2">
    {
      ZONAS.map((zona) => (
        <li
          id={`zona-${zona.id}`}
          class="scroll-mt-8 rounded-xl border border-carbon-grafito/15 bg-blanco-hueso p-3"
        >
          <h4 class="font-display text-sm font-bold text-carbon-grafito">{zona.name}</h4>
          <p class="mt-1 text-xs leading-relaxed text-carbon-grafito/65">
            {zona.description}
          </p>
        </li>
      ))
    }
  </ul>
</div>
